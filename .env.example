# Morpho API, read server-side only. With none of these set, the app reads Core REST from the
# public API (https://api.morpho.org) and the Blueprint API routes are off.
#
# Core REST, used only without MORPHO_INTERNAL_API_KEY. MORPHO_REST_API_URL points at a dedicated
# instance (default: the public API). MORPHO_API_KEY is sent as an `x-api-key` header. Keyless
# access to the public API ends after Feb 28, 2026: set MORPHO_API_KEY.
MORPHO_REST_API_URL=
MORPHO_API_KEY=
# Legacy: MORPHO_API_URL, the former GraphQL endpoint (<host>/graphql), is still read for its host
# when MORPHO_REST_API_URL is unset. Use MORPHO_REST_API_URL instead.

# Internal deployment. With the key set, every read (Core REST and the Blueprint API routes:
# vault descriptions, USD price history) goes to MORPHO_INTERNAL_API_URL with this key, sent as an
# `x-api-key` header. A key without the URL fails every read. To fail closed when either is
# missing, set APP_CONFIG.morphoApi.requireInternal to true in src/config/index.ts.
MORPHO_INTERNAL_API_URL=
MORPHO_INTERNAL_API_KEY=

NEXT_PUBLIC_URL=

# Get this from https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Required for ALL deployments, even ones that don't serve mainnet vaults or markets: the OFAC
# sanctions screening reads Chainalysis's on-chain oracle on mainnet and fails closed, so without
# a mainnet RPC every transaction flow is blocked.
MAINNET_RPC_URL_1=

BASE_RPC_URL_1=
BASE_RPC_URL_2=

POLYGON_RPC_URL_1=
POLYGON_RPC_URL_2=

UNICHAIN_RPC_URL_1=
UNICHAIN_RPC_URL_2=

KATANA_RPC_URL_1=
KATANA_RPC_URL_2=

ARBITRUM_RPC_URL_1=
ARBITRUM_RPC_URL_2=

WORLDCHAIN_RPC_URL_1=
WORLDCHAIN_RPC_URL_2=

HYPEREVM_RPC_URL_1=
HYPEREVM_RPC_URL_2=

NEXT_TELEMETRY_DISABLED=1
